# Local previews, screenshots, archives and transient logs
/work/
/outputs/
/output/
/.playwright-cli/
/dist/
/.playwright-mcp/
*.log
node_modules/
.DS_Store
Thumbs.db

# Machine-local settings and secrets
.env
.env.*
!.env.example
*.pem
*.key
.codex/
.vscode/

# Large working media; export game-ready assets into assets/
*.blend1
*.blend2
__pycache__/

# Portrait reconstruction intermediates remain local; final heads and receipts are versioned.
art/characters/portrait-v4/*/raw/
art/characters/portrait-v4/*/head-clean.blend
art/characters/portrait-v4/*/head-painted.glb
art/characters/portrait-v4/*/head-painted-views/
art/characters/portrait-v4/*/head-final.blend
art/characters/portrait-v4/*/head-paint-smooth.*
art/characters/portrait-v4/*/head-normal-sample.glb
art/characters/portrait-v4/*/head-normal-sample.blend
art/characters/portrait-v4/*/*-test.*
art/characters/portrait-v4/assembled/*-test.*
art/characters/portrait-v4/assembled/*-preview.*

# Full-body generation v5: keep raw generations and rebuild intermediates local.
art/characters/body-v5/*/raw/
art/characters/body-v5/*/raw-*/
art/characters/body-v5/*/body-clean.blend
art/characters/body-v5/*/body-painted.glb
art/characters/body-v5/*/body-painted-views/
art/characters/body-v5/*/paint-uv-state.npz
art/characters/body-v5/*/body-final.blend
art/characters/body-v5/assembled/*-test.*
art/characters/body-v5/assembled/*-control.*
art/characters/body-v5/*/*-test.*
art/characters/body-v5/*/body-uv.*
art/characters/body-v5/*/body-painted-uv.*
art/characters/body-v5/*/body-painted-uv-views/
art/characters/body-v5/*/*.paint-owner.lock
art/characters/body-v5/*/*owner*.json
art/characters/body-v5/*/body-rigged.blend

# Rebuild stages stay local; deployable GLBs live in assets/models and the
# packed editable team source lives in art/blender. Sanitized receipts are kept.
art/characters/body-v5/*/*.glb
art/characters/body-v5/*/*.blend
art/characters/body-v5/*/*.npz
art/characters/body-v5/*/*-views/
art/characters/body-v5/*/qa*/
art/characters/body-v5/*/*.receipt.json
art/characters/body-v5/*/*.qc.json
art/characters/body-v5/*/appearance*.json
art/characters/body-v5/*/head*.json
art/characters/body-v5/*/paint*.json
